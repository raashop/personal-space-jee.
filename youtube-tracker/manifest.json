{
  "manifest_version": 3,
  "name": "Personal Space — JEE Lecture Tracker",
  "version": "1.1.0",
  "description": "Recognises likely JEE lectures on YouTube, tracks watched time, and exports records for Personal Space V6.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*",
        "https://m.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JEE Lecture Tracker",
    "default_popup": "popup.html"
  }
}