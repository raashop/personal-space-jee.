{
  "manifest_version": 3,
  "name": "Personal Space — JEE Lecture Tracker",
  "version": "1.2.0",
  "description": "Automatically tracks recognized JEE lecture playback and syncs records to your Personal Space planner.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*",
        "https://m.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JEE Lecture Tracker",
    "default_popup": "popup.html"
  }
}