{
  "manifest_version": 3,
  "name": "Personal Space — Lecture Tracker",
  "version": "1.3.0",
  "description": "Tracks recognized JEE lecture playback on YouTube and Telegram Web and syncs records to Personal Space.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://web.telegram.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*",
        "https://m.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "telegram-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JEE Lecture Tracker",
    "default_popup": "popup.html"
  }
}